          "@types/react-dom": {
            "optional": true
          }
        }
      },
      "next-themes": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      },
      "sonner": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      }
    }
  }
}
