{
  "name": "htmldocs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=./packages/* --filter=!htmldocs-starter",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "publish": "pnpm run build && pnpm publish -r",
    "test": "turbo test"
  },
  "devDependencies": {
    "@htmldocs/eslint-config": "workspace:*",
    "@htmldocs/typescript-config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "happy-dom": "^20.10.5",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@8.9.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": "7.29.7",
      "@babel/helpers@<7.26.10": "7.29.7",
      "@babel/runtime@<7.26.10": "7.29.7",
      "ajv@>=6.0.0 <6.14.0": "6.15.0",
      "brace-expansion@>=1.0.0 <1.1.15": "1.1.15",
      "brace-expansion@>=2.0.0 <2.1.1": "2.1.1",
      "diff@>=4.0.0 <4.0.4": "4.0.4",
      "flatted@>=3.0.0 <3.4.2": "3.4.2",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "js-yaml@>=3.0.0 <3.14.2": "3.14.2",
      "js-yaml@>=4.0.0 <4.2.0": "4.2.0",
      "lodash@>=4.0.0 <4.18.1": "4.18.1",
      "minimatch@<3.1.5": "3.1.5",
      "minimatch@>=9.0.0 <9.0.9": "9.0.9",
      "picomatch@>=2.0.0 <2.3.2": "2.3.2",
      "postcss@<8.5.10": "8.5.15",
      "socket.io-parser@>=4.0.0 <4.2.6": "4.2.6",
      "ws@>=7.0.0 <7.5.11": "7.5.11",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "yaml@>=2.0.0 <2.8.3": "2.9.0"
    },
    "packageExtensions": {
      "@phosphor-icons/react": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      },
      "@radix-ui/react-icons": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "framer-motion": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
