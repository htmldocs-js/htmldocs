{
  "name": "htmldocs",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=./packages/* --filter=!htmldocs-starter",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "version": "changeset version && pnpm install --no-frozen-lockfile",
    "publish": "pnpm run build && pnpm publish -r",
    "test": "turbo test"
  },
  "devDependencies": {
    "@htmldocs/eslint-config": "workspace:*",
    "@htmldocs/typescript-config": "workspace:*",
    "prettier": "^3.2.5",
    "turbo": "latest",
    "vitest": "^1.3.1",
    "@vitest/coverage-v8": "^1.3.1",
    "happy-dom": "^13.3.8"
  },
  "packageManager": "pnpm@8.9.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@changesets/cli": "^2.27.9"
  },
  "pnpm": {
    "packageExtensions": {
      "@phosphor-icons/react": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      },
      "@radix-ui/react-icons": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "framer-motion": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      },
      "next": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      },
      "next-themes": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      },
      "sonner": {
        "peerDependencies": {
          "@types/react": "*",
          "@types/react-dom": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          },
          "@types/react-dom": {
            "optional": true
          }
        }
      }
    }
  }
}
